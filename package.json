{
  "name": "quasar-rsbuild-wrapper",
  "version": "1.0.0",
  "description": "Simple wrapper for qusar.config.js to allow using it with rsBuild instead of Quasar App-Webpack",
  "keywords": [
    "quasar",
    "spa",
    "vue",
    "vuejs",
    "web",
    "rspack",
    "rsbuild"
  ],
  "bugs": "https://github.com/tmcdos/quasar-rsbuild-wrapper/issues",
  "license": "MIT",
  "author": {
    "name": "TMCDOS",
    "email": "tmcdos@abv.bg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmcdos/quasar-rsbuild-wrapper.git"
  },
  "type": "module",
  "main": "index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rsbuild/core": "^2.2.4",
    "@rsbuild/plugin-eslint": "^2.0.2",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-vue": "^2.0.1",
    "dotenv": "^17.4.0",
    "dotenv-expand": "^12.0.3",
    "eta": "^4.6.0",
    "nanoid": "^6.0.2",
    "postcss-windicss": "^1.0.0",
    "rsbuild-plugin-stylelint": "^1.2.0",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "neostandard": "^0.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "pinia": "^3.0.4",
    "quasar": "^2.30.0",
    "vue": "^3.5.31",
    "vue-router": "^5.1.0"
  },
  "peerDependencies": {
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "neostandard": "^0.13.0",
    "pinia": "2.x || 3.x || 4.x",
    "quasar": "^2.30.0",
    "stylelint": "^17.14.0",
    "vue": "^3.5.31",
    "vue-router": "^5.0.0",
    "workbox-webpack-plugin": ">= 6"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    },
    "workbox-webpack-plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.14.12",
    "yarn": ">= 1.17.3"
  }
}
